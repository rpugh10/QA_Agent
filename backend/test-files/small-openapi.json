{
  "openapi": "3.0.3",
  "info": {"title": "Upload Practice API", "version": "1.0.0"},
  "paths": {
    "/health": {
      "get": {
        "summary": "Check service health",
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["status"],
                  "properties": {"status": {"type": "string", "enum": ["ok"]}}
                }
              }
            }
          }
        }
      }
    }
  }
}